    rdfs:comment "Current age of the player" ;
    rdfs:domain :Player ;
    rdfs:range xsd:integer .


##################### OWL RESTRICTIONS FOR INFERENCE ####################

# Player inference: Anyone with a position, birth year, or club affiliation is a Player
:Player owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty rel:position ;
          owl:someValuesFrom xsd:string ]
        [ a owl:Restriction ;
          owl:onProperty rel:born ;
          owl:someValuesFrom xsd:integer ]
        [ a owl:Restriction ;
          owl:onProperty rel:club ;
          owl:someValuesFrom :Club ]
        [ a owl:Restriction ;
          owl:onProperty rel:nation ;
          owl:someValuesFrom :Country ]
    )
] .

# Club inference: Entities with stadium, city, or league properties are Clubs
:Club owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty rel:stadium ;
          owl:someValuesFrom xsd:string ]
        [ a owl:Restriction ;
          owl:onProperty rel:city ;
          owl:someValuesFrom xsd:string ]
        [ a owl:Restriction ;
          owl:onProperty rel:league ;
          owl:someValuesFrom :League ]
        [ a owl:Restriction ;
          owl:onProperty rel:logo ;
          owl:someValuesFrom xsd:string ]
    )
] .

# Country inference: Entities with flag property or used as nation/country are Countries
:Country owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty rel:flag ;
          owl:someValuesFrom xsd:string ]
        [ a owl:Class ;
          owl:intersectionOf (
              [ a owl:Restriction ;
                owl:onProperty [ owl:inverseOf rel:nation ] ;
                owl:someValuesFrom :Player ]
              [ a owl:Restriction ;
                owl:onProperty rel:abrv ;
                owl:someValuesFrom xsd:string ]
          ) ]
    )
] .

# League inference: Entities that clubs participate in are Leagues
:League owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf rel:league ] ;
          owl:someValuesFrom :Club ]
    )
] .

# Goalkeeper inference: Tried many approaches, reasoner always fails
# :Goalkeeper owl:equivalentClass [
#     a owl:Class ;
#     owl:intersectionOf (
#         :Player
#         [ a owl:Restriction ;
#           owl:onProperty rel:position ;
#           owl:hasValue "GK" ]
#     )
# ] .

# OutfieldPlayer inference: Tried many approaches, reasoner always fails
# :OutfieldPlayer owl:equivalentClass [
#     a owl:Class ;
#     owl:intersectionOf (
#         :Player
#         [ a owl:Class ;
#           owl:complementOf :Goalkeeper ]
#     )
# ] .

# Additional restrictions for more precise classification

# Players must have at least a name and position
:Player rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:name ;
    owl:someValuesFrom xsd:string
] .

# Clubs must have at least a name
:Club rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:name ;
    owl:someValuesFrom xsd:string
] .

# Countries must have at least a name
:Country rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:name ;
    owl:someValuesFrom xsd:string
] .

# Leagues must have at least a name
:League rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:name ;
    owl:someValuesFrom xsd:string
] .

# Functional property restrictions for data integrity
:Player rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:club ;
    owl:maxCardinality 1
] .

:Player rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:nation ;
    owl:maxCardinality 1
] .

:Club rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:league ;
    owl:maxCardinality 1
] .

:Club rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rel:country ;
    owl:maxCardinality 1
] .
